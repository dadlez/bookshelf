{
  "name": "bookshelf",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=@bookshelf/shared",
    "dev:backend": "npm run build:shared && npm run dev --workspace=@bookshelf/backend",
    "dev:frontend": "npm run build:shared && npm run dev --workspace=@bookshelf/frontend",
    "db": "docker compose up --build -d",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file=backend/.env database/migrate.js",
    "db:seed100k": "node --env-file=backend/.env database/seed100k.js",
    "db:seed1M": "node --env-file=backend/.env database/seed1M.js"

  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
