{
  "name": "bookshelf",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=@bookshelf/backend",
    "dev:frontend": "npm run dev --workspace=@bookshelf/frontend",
    "db": "docker compose up --build -d",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file=backend/.env database/migrate.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
